<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="16dp">

    <!-- Titre -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#4CAF50">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GESTION DES CLIENTS"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Switch 3 onglets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnSwitchReservation"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Reservations"
            android:textSize="13sp"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_marginRight="3dp"/>

        <Button
            android:id="@+id/btnSwitchOccupation"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Occupations"
            android:textSize="13sp"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"/>

        <Button
            android:id="@+id/btnSwitchSejour"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Sejours"
            android:textSize="13sp"
            android:backgroundTint="#9C27B0"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="3dp"/>

    </LinearLayout>

    <!-- Formulaire (cache en mode Occupation) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardFormulaire"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF">

            <Spinner
                android:id="@+id/spinnerChambresClients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etDateEntreeClients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Date (jj/mm/aaaa)"
                android:inputType="number"
                android:background="@android:drawable/editbox_background"
                android:padding="12dp"
                android:maxLength="10"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvPrixTotalClients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prix / nuit: 0 Ar"
                android:textSize="14sp"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etNbrJourClients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre de jours"
                android:inputType="number"
                android:layout_marginBottom="8dp"
                android:background="@android:drawable/editbox_background"
                android:padding="12dp"/>

            <EditText
                android:id="@+id/etNomClientClients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nom du client"
                android:inputType="text"
                android:layout_marginBottom="8dp"
                android:background="@android:drawable/editbox_background"
                android:padding="12dp"/>

            <!-- Email (Reservation) -->
            <EditText
                android:id="@+id/etMailClients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email du client"
                android:inputType="textEmailAddress"
                android:background="@android:drawable/editbox_background"
                android:padding="12dp"/>

            <!-- Telephone (Sejour) -->
            <EditText
                android:id="@+id/etTelephoneClients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Telephone"
                android:inputType="phone"
                android:background="@android:drawable/editbox_background"
                android:padding="12dp"
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Reservations (seul) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardReservation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Liste des reservations"
                android:textSize="14sp"
                android:textColor="#999999"
                android:layout_marginBottom="8dp"/>

            <ListView
                android:id="@+id/listViewReservationsClients"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:divider="#E0E0E0"
                android:dividerHeight="1dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnReserverClients"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Reserver"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:layout_marginRight="4dp"/>

                <Button
                    android:id="@+id/btnAnnulerReservationClients"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Annuler"
                    android:backgroundTint="#F44336"
                    android:textColor="#FFFFFF"
                    android:enabled="false"
                    android:layout_marginLeft="4dp"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Occupations (seul) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardOccupation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selectionner une reservation"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/spinnerReservationsOccuper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@android:drawable/editbox_background"
                android:padding="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Liste des occupations"
                android:textSize="14sp"
                android:textColor="#999999"
                android:layout_marginBottom="8dp"/>

            <ListView
                android:id="@+id/listViewOccupationsClients"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:divider="#E0E0E0"
                android:dividerHeight="1dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnOccuperClients"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Occuper"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:layout_marginRight="4dp"/>

                <Button
                    android:id="@+id/btnSupprimerOccupationClients"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Supprimer"
                    android:backgroundTint="#F44336"
                    android:textColor="#FFFFFF"
                    android:enabled="false"
                    android:layout_marginLeft="4dp"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Sejours (seul) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSejour"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Liste des sejours"
                android:textSize="14sp"
                android:textColor="#999999"
                android:layout_marginBottom="8dp"/>

            <ListView
                android:id="@+id/listViewSejoursClients"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:divider="#E0E0E0"
                android:dividerHeight="1dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnSejournerClients"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Enregistrer"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:layout_marginRight="4dp"/>

                <Button
                    android:id="@+id/btnSupprimerSejourClients"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Supprimer"
                    android:backgroundTint="#F44336"
                    android:textColor="#FFFFFF"
                    android:enabled="false"
                    android:layout_marginRight="4dp"/>

                <Button
                    android:id="@+id/btnPDFClients"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="PDF"
                    android:backgroundTint="#795548"
                    android:textColor="#FFFFFF"
                    android:enabled="false"
                    android:layout_marginLeft="4dp"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
